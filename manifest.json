{
  "schemaVersion": 1,
  "id": "bert.flyby",
  "name": "Flyby",
  "version": "0.2.0",
  "author": "@AlbertDIII",
  "description": "A radar scope of the aircraft overhead — identify any of them (type, operator, route, specs, photo) and fill a logbook of every type you've spotted. Free community ADS-B data, no account.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Flyby",
    "description": "Radar scope of nearby aircraft, an identity card for any of them, and a logbook of the types you've spotted",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "latitude": "",
      "longitude": "",
      "radiusNm": "25",
      "provider": "adsb.lol",
      "units": "km",
      "notifyOverhead": false,
      "notifyDiscovery": true,
      "showGround": false,
      "readablePill": false,
      "altColor": false,
      "routeLookup": true,
      "showPhotos": false,
      "overheadOnlyLog": false
    },
    "schema": [
      { "key": "latitude", "type": "string", "label": "Latitude", "description": "Decimal degrees, e.g. 29.4241. Leave blank and use “Locate me” in the popup." },
      { "key": "longitude", "type": "string", "label": "Longitude", "description": "Decimal degrees, e.g. -98.4936." },
      { "key": "radiusNm", "type": "enum", "label": "Range (nm)", "options": ["5", "10", "25", "50", "100"], "defaultValue": "25" },
      { "key": "provider", "type": "enum", "label": "Data source", "options": ["adsb.lol", "adsb.fi"], "defaultValue": "adsb.lol" },
      { "key": "units", "type": "enum", "label": "Distance units", "options": ["km", "mi", "nm"], "defaultValue": "km" },
      { "key": "notifyOverhead", "type": "boolean", "label": "Notify when a plane passes overhead", "defaultValue": false },
      { "key": "notifyDiscovery", "type": "boolean", "label": "Notify when a new aircraft type is logged", "defaultValue": true },
      { "key": "showGround", "type": "boolean", "label": "Include aircraft on the ground", "defaultValue": false },
      { "key": "readablePill", "type": "boolean", "label": "Bar pill shows aircraft type instead of callsign", "defaultValue": false },
      { "key": "altColor", "type": "boolean", "label": "Colour radar blips by altitude", "defaultValue": false },
      { "key": "routeLookup", "type": "boolean", "label": "Look up route & owner for the selected aircraft (adsbdb.com)", "defaultValue": true },
      { "key": "showPhotos", "type": "boolean", "label": "Show a photo of the selected airframe (airport-data.com / planespotters.net)", "defaultValue": false },
      { "key": "overheadOnlyLog", "type": "boolean", "label": "Only log a type once it has actually passed overhead (within 3 km)", "defaultValue": false }
    ]
  }
}
